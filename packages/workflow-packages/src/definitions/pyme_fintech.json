{
  "id": "pyme_fintech",
  "name": "Cobranza digital",
  "description": "Estrategia digital-first con WhatsApp como canal principal, pensada para volúmenes medios.",
  "profile": "Fintechs, neobancos y PyMEs con cartera diversificada y comunicación omnicanal.",
  "rules": [
    {
      "name": "Deuda nueva — WhatsApp opt-in",
      "trigger": "debt_created",
      "condition": {
        "status": [
          "new",
          "upcoming",
          "analyzing",
          "active"
        ],
        "whatsapp_opt_in": true
      },
      "action": "send_notification",
      "channel": "whatsapp",
      "delay_hours": 1,
      "priority": 10
    },
    {
      "name": "Deuda nueva — email fallback",
      "trigger": "debt_created",
      "condition": {
        "status": [
          "new",
          "upcoming",
          "analyzing",
          "active"
        ]
      },
      "action": "send_notification",
      "channel": "email",
      "delay_hours": 2,
      "priority": 15
    },
    {
      "name": "Score bajo — WhatsApp prioritario",
      "trigger": "score_updated",
      "condition": {
        "ai_score": {
          "lt": 40
        },
        "whatsapp_opt_in": true
      },
      "action": "send_notification",
      "channel": "whatsapp",
      "delay_hours": 2,
      "priority": 20
    },
    {
      "name": "Pre-vencimiento -7d — WhatsApp recordatorio",
      "trigger": "schedule",
      "condition": {
        "days_to_due": {
          "gte": 1,
          "lte": 7
        }
      },
      "action": "send_notification",
      "channel": "whatsapp",
      "delay_hours": 0,
      "priority": 28
    },
    {
      "name": "Aging 0-30 — WhatsApp recordatorio",
      "trigger": "schedule",
      "condition": {
        "aging_days": {
          "gte": 0,
          "lte": 30
        }
      },
      "action": "send_notification",
      "channel": "whatsapp",
      "delay_hours": 0,
      "priority": 30
    },
    {
      "name": "Aging 31-60 — WhatsApp",
      "trigger": "schedule",
      "condition": {
        "aging_days": {
          "gte": 31,
          "lte": 60
        }
      },
      "action": "send_notification",
      "channel": "whatsapp",
      "delay_hours": 0,
      "priority": 25
    },
    {
      "name": "Promesa rota — escalar agente",
      "trigger": "promise_broken",
      "condition": {},
      "action": "escalate_human",
      "channel": "email",
      "delay_hours": 4,
      "priority": 5
    },
    {
      "name": "Promesa cumplida — WhatsApp",
      "trigger": "promise_kept",
      "condition": {},
      "action": "send_notification",
      "channel": "whatsapp",
      "delay_hours": 0,
      "priority": 8
    },
    {
      "name": "Pago recibido — agradecimiento WhatsApp",
      "trigger": "payment_confirmed",
      "condition": {
        "status": "paid_full"
      },
      "action": "send_notification",
      "channel": "whatsapp",
      "delay_hours": 0,
      "priority": 10
    }
  ]
}
