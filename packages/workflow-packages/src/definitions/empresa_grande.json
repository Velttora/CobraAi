{
  "id": "empresa_grande",
  "name": "Cobranza corporativa",
  "description": "Estrategia formal para cuentas por cobrar B2B: montos altos, ciclos largos y escalamiento progresivo.",
  "profile": "Facturación empresarial, carteras concentradas y deudores de alto valor.",
  "rules": [
    {
      "name": "Bienvenida — email formal",
      "trigger": "debt_created",
      "condition": {
        "status": [
          "new",
          "upcoming",
          "analyzing",
          "active"
        ]
      },
      "action": "send_notification",
      "channel": "email",
      "delay_hours": 0,
      "priority": 10
    },
    {
      "name": "Segmento crítico — asignar estrategia",
      "trigger": "score_updated",
      "condition": {
        "ai_segment": "critical"
      },
      "action": "assign_strategy",
      "delay_hours": 0,
      "priority": 5
    },
    {
      "name": "Pre-vencimiento -7d — recordatorio email",
      "trigger": "schedule",
      "condition": {
        "days_to_due": {
          "gte": 1,
          "lte": 7
        }
      },
      "action": "send_notification",
      "channel": "email",
      "delay_hours": 0,
      "priority": 28
    },
    {
      "name": "Aging 31-60 — recordatorio email",
      "trigger": "schedule",
      "condition": {
        "aging_days": {
          "gte": 31,
          "lte": 60
        }
      },
      "action": "send_notification",
      "channel": "email",
      "delay_hours": 0,
      "priority": 30
    },
    {
      "name": "Aging 61-90 — llamada IA",
      "trigger": "schedule",
      "condition": {
        "aging_days": {
          "gte": 61,
          "lte": 90
        }
      },
      "action": "send_notification",
      "channel": "voice",
      "delay_hours": 0,
      "priority": 25
    },
    {
      "name": "Aging 90+ — WhatsApp urgente",
      "trigger": "schedule",
      "condition": {
        "aging_days": {
          "gte": 91
        }
      },
      "action": "send_notification",
      "channel": "whatsapp",
      "delay_hours": 0,
      "priority": 20
    },
    {
      "name": "Promesa rota — escalamiento humano",
      "trigger": "promise_broken",
      "condition": {},
      "action": "escalate_human",
      "channel": "voice",
      "delay_hours": 4,
      "priority": 5
    },
    {
      "name": "Monto alto vencido — llamada IA",
      "trigger": "schedule",
      "condition": {
        "amount_outstanding": {
          "gte": 5000000
        },
        "aging_days": {
          "gte": 45
        }
      },
      "action": "send_notification",
      "channel": "voice",
      "delay_hours": 0,
      "priority": 15
    },
    {
      "name": "Promesa cumplida — WhatsApp",
      "trigger": "promise_kept",
      "condition": {},
      "action": "send_notification",
      "channel": "whatsapp",
      "delay_hours": 0,
      "priority": 8
    },
    {
      "name": "Pago total — agradecimiento email",
      "trigger": "payment_confirmed",
      "condition": {
        "amount_outstanding": 0
      },
      "action": "send_notification",
      "channel": "email",
      "delay_hours": 0,
      "priority": 10
    }
  ]
}
